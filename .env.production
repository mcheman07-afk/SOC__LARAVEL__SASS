# ============================================================
#  ISTE SECURE - Plantilla de entorno para HOSTING (producción)
#  Copiar como ".env" en el servidor y completar los valores.
#  NUNCA subir el .env local (APP_DEBUG=true) al hosting.
# ============================================================

APP_NAME="ISTE SECURE"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://TU-DOMINIO.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Base de datos MySQL del hosting (recomendado en compartidos)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iste_secure
DB_USERNAME=iste_secure
DB_PASSWORD=CAMBIA-ESTA-CLAVE

# Sesión y cookies endurecidas (solo HTTPS)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=iste_secure

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
